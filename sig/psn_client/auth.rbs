module PSN
  class Auth
    AUTH_BASE: String
    CLIENT_ID: String
    CLIENT_SECRET: String
    REDIRECT_URI: String
    SCOPE: String
    EXPIRY_BUFFER: Integer

    # Called with each new refresh token; two-argument callbacks also get the
    # new access token's expiry.
    type token_refresh_callback = ^(String) -> void | ^(String, Time) -> void

    attr_reader refresh_token: String?
    attr_reader expires_at: Time?

    def initialize: (?npsso: String?, ?refresh_token: String?, ?on_token_refresh: token_refresh_callback?) -> void
    def access_token: () -> String
    def refresh!: () -> String

    private

    def notifying_rotation: [T] () { () -> T } -> T
    def deliver_rotation: (String token, Time expires_at) -> void
    def expired?: () -> boolish
    def authenticate: () -> String
    def refresh: () -> String
    def authorization_code: () -> String
    def extract_code: (untyped resp) -> String?
    def request_token: (::Hash[String, String] params) -> String
    def apply_tokens: (::Hash[String, untyped] data) -> String
    def http: () -> untyped
  end
end
